            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueCategory": {
        "type": "string",
        "enum": [
          "Security",
          "Performance",
          "Code Style",
          "Maintainability"
        ],
        "title": "IssueCategory",
        "description": "Categories of issues"
      },
      "IssueDetail": {
        "properties": {
          "severity": {
            "$ref": "#/components/schemas/SeverityLevel",
            "description": "Severity level of the issue"
          },
          "category": {
            "$ref": "#/components/schemas/IssueCategory",
            "description": "Category of the issue"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title of the issue"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Detailed description of the issue"
          },
          "file": {
            "type": "string",
            "title": "File",
            "description": "File path where issue was found"
          },
          "line": {
            "type": "integer",
            "title": "Line",
            "description": "Line number where issue was found"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation",
            "description": "Recommendation to fix the issue"
          }
        },
        "type": "object",
        "required": [
          "severity",
          "category",
          "title",
          "description",
          "file",
          "line",
          "recommendation"
        ],
        "title": "IssueDetail",
        "description": "Detailed information about a specific issue",
        "example": {
          "category": "Security",
          "description": "Database credentials are hardcoded in the source code",
          "file": "app/core/database.py",
          "line": 15,
          "recommendation": "Use environment variables or secure vault for credentials",
          "severity": "High",
          "title": "Hardcoded Credentials"
        }
      },
      "ScanRequest": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "URL to scan"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform",
            "description": "Social media platform"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data",
            "description": "Additional data"
          }
        },
        "type": "object",
        "title": "ScanRequest",
        "description": "Schema for scan request payload",
        "example": {
          "data": {
            "user_id": "123456"
          },
          "platform": "facebook",
          "url": "https://facebook.com/example"
        }
      },
      "ScanResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Status of the scan operation",
            "default": "success"
          },
          "scanned_files": {
            "type": "integer",
            "title": "Scanned Files",
            "description": "Number of files scanned"
          },
          "issues_found": {
            "type": "integer",
            "title": "Issues Found",
            "description": "Total number of issues found"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/IssueDetail"
            },
            "type": "array",
            "title": "Details",
            "description": "Detailed list of issues found"
          }
        },
        "type": "object",
        "required": [
          "scanned_files",
          "issues_found",
          "details"
        ],
        "title": "ScanResponse",
        "description": "Schema for scan response with detailed analysis results",
        "example": {
          "details": [
            {
              "category": "Security",
              "description": "Database credentials are hardcoded in the source code",
              "file": "app/core/database.py",
              "line": 15,
              "recommendation": "Use environment variables or secure vault for credentials",
              "severity": "High",
              "title": "Hardcoded Credentials"
            },
            {
              "category": "Performance",
              "description": "Multiple database queries in a loop causing performance issues",
              "file": "app/services/user_service.py",
              "line": 45,
              "recommendation": "Use eager loading or batch queries to optimize database access",
              "severity": "Medium",
              "title": "N+1 Query Problem"
            },
            {
              "category": "Code Style",
              "description": "Function parameters lack type hints",
              "file": "app/utils/helpers.py",
              "line": 23,
              "recommendation": "Add type hints to improve code readability and IDE support",
              "severity": "Low",
              "title": "Missing Type Hints"
            }
          ],
          "issues_found": 3,
          "scanned_files": 142,
          "status": "success"
        }
      },
      "SeverityLevel": {
        "type": "string",
        "enum": [
          "High",
          "Medium",
          "Low"
        ],
        "title": "SeverityLevel",
        "description": "Severity levels for issues"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
